# Neon pooled connection string (app runtime). Server-only.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Neon direct connection string (migrations only, optional). Server-only.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Secret for sessions, at least 32 characters: openssl rand -base64 32. Server-only.
BETTER_AUTH_SECRET=
# Production URL of the app (optional; falls back to https://$VERCEL_URL, then http://localhost:3000).
BETTER_AUTH_URL=https://your-app.vercel.app
# Gmail account that sends the login codes (required in production).
GMAIL_USER=you@gmail.com
# Google app password for that account (required in production; unset in dev = code is logged to the console). Server-only.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# VAPID private key from: npx web-push generate-vapid-keys. Server-only.
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com.
VAPID_SUBJECT=mailto:you@example.com
# VAPID public key (same pair as above). Public by design.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Set to "true" to run the service worker in `next dev` (optional).
NEXT_PUBLIC_ENABLE_SW_IN_DEV=
# Anthropic API key for "Verras me" meal ideas (optional; without it the button reports it is not set up). Server-only.
ANTHROPIC_API_KEY=
